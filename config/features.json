  "cruce_mysql_mixpanel": {
    "_nota": "Propiedades para cruzar datos entre MySQL y Mixpanel. Usar colegio_rbd (no rbd) como campo universal.",
    "campos_cruce_universales": {
      "colegio_rbd": {
        "mixpanel": "colegio_rbd (number) — presente en TODOS los eventos",
        "mysql": "colegio.colegio_rbd / colegio_config.rbd / fur_*.form_rbd / registro_pie.registro_rbd",
        "nota": "Campo de cruce mas confiable. NO usar 'rbd' (solo FUR lo tiene)"
      },
      "user_id": {
        "mixpanel": "user_id (number)",
        "mysql": "users.id / registro_pie.user_id / perfil_user.user_id",
        "nota": "En QA, user_ids > 518 son de produccion y no existen en tabla users de inteduc_beta"
      },
      "rut": {
        "mixpanel": "rut (string) — alumno",
        "mysql": "fur_transitorio.alumno_rut / fur_permanente.alumno_rut / pie_form_fudei.alumno_rut"
      },
      "form_id": {
        "mixpanel": "form_id (number/string) — en FUR y FUDEI",
        "mysql": "fur_transitorio.form_id (PK) / pie_form_fudei.form_id"
      }
    },
    "propiedades_por_evento": {
      "FUR_Import": ["user_id", "colegio_rbd", "colegio_name", "rbd", "rut", "form_id", "anio", "nee", "fur_tipo", "fur_destino", "modo_importacion", "importacion_id", "isCanary", "tracking_nivel"],

# ============================================
# PIE-INSIGHTS — Variables de Entorno
# ============================================
# Copia este archivo como .env y completa los valores
# cp .env.example .env

# --- Mixpanel API ---
# Service Account credentials (pedir al admin del proyecto)
# Doc: https://developer.mixpanel.com/reference/authentication
MIXPANEL_PROJECT_ID=
MIXPANEL_API_SECRET=
# Opcional: Service Account (alternativa al API Secret)
MIXPANEL_SERVICE_ACCOUNT_USERNAME=
MIXPANEL_SERVICE_ACCOUNT_PASSWORD=

# --- Configuracion general ---
# Zona horaria del proyecto (Chile)
TIMEZONE=America/Santiago
# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Alertas (opcional, Sprint 3+) ---
# Slack webhook para alertas de bajo uso
SLACK_WEBHOOK_URL=
# Email para reportes (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
